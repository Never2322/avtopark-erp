@echo off
chcp 65001 >nul
cd /d "%~dp0"
title Настройки программы

if not exist ".env" (
  echo.
  echo  Файл настроек .env ещё не создан. Сначала запустите Запустить.bat.
  pause
  exit /b 1
)

echo.
echo  Сейчас откроется файл настроек .env в Блокноте.
echo  Измените нужные строки, сохраните файл (Ctrl+S) и закройте Блокнот.
echo  Потом запустите Запустить.bat: он применит изменения. Данные не пропадут.
echo  Файл .env никому не показывайте: в нём пароли и ключи.
echo.
notepad ".env"
