# Скопируйте этот файл в .env и замените значения. Файл .env никому не показывайте и не отправляйте.

# --- База данных (используется только внутри Docker, снаружи она не открыта)
POSTGRES_USER=erp
POSTGRES_PASSWORD=замените-на-длинный-случайный-пароль
POSTGRES_DB=erp

# --- Первый администратор. Создаётся один раз, когда в базе ещё нет ни одного пользователя.
# После первого входа пароль лучше сменить в «Профиле», а эти две строки можно удалить.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=замените-на-свой-пароль-не-короче-8-символов

# --- Сайт
HTTP_PORT=8080
# Когда сайт открывается по https (с замком в адресной строке), поставьте true
COOKIE_SECURE=false
ORG_TIMEZONE=Asia/Novosibirsk
DEFAULT_LEGAL_ENTITY=ООО «Основное»
# Карта 2ГИС (раздел «Карта»). Ключ создаётся бесплатно на https://platform.2gis.ru (демо-ключ живёт месяц).
# Пока ключа нет, карта не рисуется, а в нарядах работают ссылки «на карте» (открывают 2ГИС в новой вкладке).
TWOGIS_KEY=
# Город дописывается к адресу без города при поиске точки на карте; центр и приближение карты по умолчанию
MAP_CITY=Новосибирск
MAP_LON=82.92
MAP_LAT=55.03
MAP_ZOOM=11
# Страница описания программного интерфейса (/api/docs). На рабочем сервере её лучше выключить: false
DOCS_ENABLED=true

# --- Резервные копии
BACKUP_KEEP=14
BACKUP_HOUR=3

# --- Telegram и почта (необязательно). Пока ключей нет, уведомления приходят только на сайте (колокольчик).
# Подробно: docs/Telegram-и-почта.md. После изменения этих строк выполните: docker compose up -d
# Адрес сайта: добавляется ссылкой в сообщения. Например, https://park.example.ru или http://192.168.1.10:8080
PUBLIC_URL=
# Telegram: ключ бота от @BotFather (выглядит как 123456789:AAH...). Пусто: Telegram выключен.
TELEGRAM_BOT_TOKEN=
# Почта: сервер исходящей почты. Пусто: почта выключена.
# SMTP_SECURITY: starttls (обычно порт 587), ssl (обычно порт 465) или none (только для своего сервера в локальной сети)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# От чьего имени идут письма; если пусто, берётся SMTP_USER
SMTP_FROM=

# --- Копия базы вне сервера (необязательно). Файл копии шифруется и уходит в Telegram и/или на почту после каждой копии.
# Без пароля шифрования копии вне сервера не отправляются совсем. Запишите пароль в надёжном месте: без него копию не расшифровать.
OFFSITE_PASSWORD=
# Куда слать по почте (через запятую). По Telegram копия идёт тем, у кого есть право на копии и подключён Telegram (или в чат OFFSITE_TELEGRAM_CHAT_ID)
OFFSITE_EMAIL_TO=
OFFSITE_TELEGRAM_CHAT_ID=
# Больше этого размера по почте не отправляется (у почтовых служб есть предел). В Telegram предел 49 МБ
OFFSITE_EMAIL_MAX_MB=20
