# Скопируйте этот файл в .env и замените значения. Файл .env никому не показывайте и не отправляйте.

# --- База данных (используется только внутри Docker, снаружи она не открыта)
POSTGRES_USER=erp
POSTGRES_PASSWORD=замените-на-длинный-случайный-пароль
POSTGRES_DB=erp

# --- Первый администратор. Создаётся один раз, когда в базе ещё нет ни одного пользователя.
# После первого входа пароль лучше сменить в «Профиле», а эти две строки можно удалить.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=замените-на-свой-пароль-не-короче-8-символов

# --- Сайт
HTTP_PORT=8080
# Когда сайт открывается по https (с замком в адресной строке), поставьте true
COOKIE_SECURE=false
ORG_TIMEZONE=Asia/Novosibirsk
DEFAULT_LEGAL_ENTITY=ООО «Основное»
# Страница описания программного интерфейса (/api/docs). На рабочем сервере её лучше выключить: false
DOCS_ENABLED=true

# --- Резервные копии
BACKUP_KEEP=14
BACKUP_HOUR=3
